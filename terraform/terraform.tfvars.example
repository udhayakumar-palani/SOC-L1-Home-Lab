# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars (it's
# gitignored) - and put the three secret variables in your shell environment
# instead (see below), not in this file, so they never land in state history
# or get committed by accident.

aws_region = "us-east-1"
project_name = "soc-lab"

# curl -s https://checkip.amazonaws.com
my_ip = "203.0.113.4/32"

key_name = "soc-lab-key"

# From AWS Marketplace after subscribing to Kali Linux - see docs/01-prerequisites.md
kali_ami_id = "ami-xxxxxxxxxxxxxxxxx"

enable_suricata_ids = true

# This AWS account currently allows only t3.small (2 vCPU/2GB) or smaller -
# t3.medium/t3.large are rejected with "not eligible for Free Tier" even
# after a vCPU quota increase (confirmed: this is an instance-size gate, not
# a region-specific or vCPU-count issue - see AWS Support case history).
# Splunk/TheHive will be resource-tight at this size; raise these back to
# the defaults in variables.tf once AWS lifts the restriction.
kali_instance_type     = "t3.small"
windows_instance_type  = "t3.small"
ubuntu_instance_type   = "t3.small"
splunk_instance_type   = "t3.small"
thehive_instance_type  = "t3.small"
suricata_instance_type = "t3.small"

# --- Secrets: export these instead of putting them here ---
#   export TF_VAR_splunk_admin_password='ChangeMe_Strong_Pw_123!'
#   export TF_VAR_thehive_secret=$(openssl rand -hex 32)
#   export TF_VAR_splunk_uf_pass4symmkey=$(openssl rand -hex 24)
