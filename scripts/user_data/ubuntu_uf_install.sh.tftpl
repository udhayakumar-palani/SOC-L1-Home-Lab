#!/bin/bash
set -eux

# Splunk Universal Forwarder for the Ubuntu "victim/log source" box (auth.log, syslog).
# Pin/verify this version+URL against https://www.splunk.com/en_us/download/universal-forwarder.html
# if the download 404s (Splunk build hashes rotate with every release).
UF_VERSION=9.2.1
UF_BUILD=78803f08aabb
UF_URL=https://download.splunk.com/products/universalforwarder/releases/$UF_VERSION/linux/splunkforwarder-$UF_VERSION-$UF_BUILD-linux-2.6-amd64.deb

cd /tmp
wget -q -O splunkforwarder.deb "$UF_URL"
dpkg -i splunkforwarder.deb

mkdir -p /opt/splunkforwarder/etc/system/local

cat >/opt/splunkforwarder/etc/system/local/outputs.conf <<'EOF'
[tcpout]
defaultGroup = primary_indexers
pass4SymmKey = ${pass4symmkey}

[tcpout:primary_indexers]
server = ${splunk_ip}:9997
EOF

cat >/opt/splunkforwarder/etc/system/local/inputs.conf <<'EOF'
[monitor:///var/log/auth.log]
disabled = 0
index = main
sourcetype = linux_secure

[monitor:///var/log/syslog]
disabled = 0
index = main
sourcetype = syslog
EOF

/opt/splunkforwarder/bin/splunk start --accept-license --no-prompt --answer-yes --seed-passwd 'ChangeMe_UF_123!'
/opt/splunkforwarder/bin/splunk enable boot-start -user root --accept-license --answer-yes --no-prompt
